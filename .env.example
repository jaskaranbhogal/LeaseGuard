# These variables are read from the process environment, not loaded automatically.
# Example: set -a; source .env; set +a (after copying and configuring this file).
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set a persistent, private signing key for deployment. Never commit it.
DJANGO_SECRET_KEY=
# Optional separate SQLite database for manual tests:
# DJANGO_DATABASE_PATH=/tmp/leaseguard-manual.sqlite3

# Default development mode: console only; no email is delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PASSWORD_RESET_BASE_URL=http://localhost:8000

# Google OAuth client IDs allowed by the Django OIDC ID-token verifier.
# Comma-separated Android and iOS OAuth client IDs from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_IDS=

# Comma-separated Apple app bundle ID / Services ID audiences for ID-token checks.
# The iOS app bundle ID is currently org.reactjs.native.example.frontend.
APPLE_SIGN_IN_CLIENT_IDS=

# To send real mail, use django.core.mail.backends.smtp.EmailBackend and configure:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
